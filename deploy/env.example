# Host-specific configuration for the proxy scanner.
#
# Copy to /opt/proxy-scanner/.env — Compose reads it automatically for ${VAR}
# substitution in docker-compose.yml. Everything here has a working default, so
# an empty .env is valid; set values only where the default is wrong for you.
#
# This file may contain secrets. Keep it 0600 and root-owned.

# ---- API exposure ----
# Address the API listens on. Defaults to 127.0.0.1, which means loopback only —
# nothing reachable off-box. Set this to the host's Tailscale address to expose
# the API to the tailnet without publishing it to the internet.
#   API_BIND_ADDR=100.74.109.25
API_BIND_ADDR=127.0.0.1
API_PORT=8080

# Bearer token required on every route except /v1/health. Leave empty to disable
# auth entirely. Strongly recommended if API_BIND_ADDR is anything but loopback.
#   API_TOKEN=$(openssl rand -hex 32)
API_TOKEN=

# ---- Scanner ----
# Packets per second. Do not raise this above 50000: it is the documented
# ceiling for abuse-complaint avoidance, and higher rates also cause packet loss
# on shared cloud NICs, which silently costs you coverage.
SCAN_RATE=50000

# SOCKS ports to probe. The probe count is addresses_in_scope x ports, so adding
# a port directly extends the sweep time.
SCAN_PORTS=1080,1081,9050

# Network interface for masscan. Leave EMPTY to let masscan pick the
# default-route interface, which is correct on almost every host. Set it only if
# that guess is wrong. To find the right name:
#   ip -o route show default | awk '{print $5}'
# The old value "ens3" was an OpenStack-ism and does not exist on Debian, where
# the interface is usually eth0 or enp1s0.
SCAN_ADAPTER=
