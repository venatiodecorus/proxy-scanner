[Unit]
Description=Proxy scanner validation safety net every eight hours
Documentation=https://github.com/venatiodecorus/proxy-scanner

[Timer]
# The validator normally runs via OnSuccess= the instant a scan session ends.
# This timer only matters when a scan was skipped or failed but candidates are
# still queued — an empty queue makes the run a no-op that exits immediately.
# Run at 07:00, 15:00, and 23:00 UTC, one hour after each expected scan
# window closes. OnSuccess= remains the primary trigger.
OnCalendar=*-*-* 07/8:00:00 UTC
Persistent=true
AccuracySec=1min
Unit=proxy-scanner-validate.service

[Install]
WantedBy=timers.target
